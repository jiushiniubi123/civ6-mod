<?xml version="1.0" encoding="utf-8"?>
<Mod id="b21bf49d-565e-42bb-a4e9-379a9facb54f" version="1">
  <Properties>
    <Name>Sukritact's Urban Identities</Name>
    <Description>Identities are traits your cities can earn, changing the rules of city planning. Only cities owned by a civilization can have Identities. Identities may have both positive and negative effects on your city. They may provide bonuses or maluses to certain districts or improvements. Some may have a condition that you must fulfil to reap the rewards. Either way, they often encourage you to lay out your districts and improvements in a way you might not do otherwise.[NEWLINE][NEWLINE]Gain Identities by being the first civilization to found or capture a city in an unclaimed Region (areas of the map that have been marked off as special in some way). Doing this claims the Region for that city, and earns the Region’s associated Identity for that city.</Description>
    <Created>1731530391</Created>
    <Teaser>Urban Identities gives your cities character! What cities will you build?</Teaser>
    <Authors>Sukritact, Leugi, CaptainLime, Pouakai</Authors>
    <SpecialThanks>Andrew Dittmann, Matt Lambert, Pinary, Slothoth</SpecialThanks>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <Dependencies>
    <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
  </Dependencies>
  <References>
    <Mod id="4922ba47-61e1-4b15-9281-db996b14522d" title="Sukritact's Oceans" />
  </References>
  <ActionCriteria>
    <Criteria id="NeverMet" />
    <Criteria id="GameModeEnabled">
      <ConfigurationValueMatches>
        <Group>Game</Group>
        <ConfigurationId>GAMEMODE_SUK_URBANIDENTITIES</ConfigurationId>
        <Value>1</Value>
      </ConfigurationValueMatches>
    </Criteria>
  </ActionCriteria>
