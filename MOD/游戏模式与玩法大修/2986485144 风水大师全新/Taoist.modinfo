<?xml version="1.0" encoding="utf-8"?>
<Mod id="7c767f7a-2f1d-42bd-88bd-33c97031c640" version="1">
  <Properties>
    <Name>LOC_PEN_TAOIST_NAME</Name>
    <Description>LOC_PEN_TAOIST_DESCRIPTION</Description>
    <CustomProperties></CustomProperties>
    <Created>1686229152</Created>
    <Teaser>LOC_PEN_TAOIST_TEASER</Teaser>
    <Authors>pen</Authors>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <LocalizedText>
    <Text id="LOC_PEN_TAOIST_NAME">
      <en_US>Pen's LeyLine Detector</en_US>
	  <zh_Hant_HK>Pen的風水先生</zh_Hant_HK>
      <zh_Hans_CN>Pen的风水师</zh_Hans_CN>
    </Text>
    <Text id="LOC_PEN_TAOIST_TEASER">
      <en_US>Added a unit: LeyLine Detector</en_US>
	  <zh_Hant_HK>添加單位：風水先生</zh_Hant_HK>
      <zh_Hans_CN>添加单位：风水师</zh_Hans_CN>
    </Text>
    <Text id="LOC_PEN_TAOIST_DESCRIPTION">
      <en_US>Added a unit: LeyLine Detector for Hermetic Order</en_US>
	  <zh_Hant_HK>給秘密結社黃金黎明協會添加單位：風水先生</zh_Hant_HK>
      <zh_Hans_CN>给秘密结社黄金黎明协会添加单位：风水师</zh_Hans_CN>
    </Text>
  </LocalizedText>
  <ActionCriteria>
    <Criteria id="SecretSocieties">
      <ConfigurationValueMatches>
        <ConfigurationId>GAMEMODE_SECRETSOCIETIES</ConfigurationId>
        <Group>Game</Group>
        <Value>1</Value>
      </ConfigurationValueMatches>
    </Criteria>
	<Criteria id="Taoist_InitialActions_0" any="1">
      <ConfigurationValueMatches>
        <ConfigurationId>Taoist_InitialActionsTimes</ConfigurationId>
        <Group>Game</Group>
        <Value>0</Value>
      </ConfigurationValueMatches>
	  <ConfigurationValueMatches>
		<Group>Game</Group>
		<ConfigurationId>Taoist_Settings</ConfigurationId>
		<Value>SETTINGS_TAOIST_NORMAL</Value>
	  </ConfigurationValueMatches>
    </Criteria>
    <Criteria id="Taoist_InitialActions_2">
      <ConfigurationValueMatches>
        <ConfigurationId>Taoist_InitialActionsTimes</ConfigurationId>
        <Group>Game</Group>
        <Value>2</Value>
      </ConfigurationValueMatches>
    </Criteria>
	<Criteria id="Taoist_InitialActions_3">
      <ConfigurationValueMatches>
        <ConfigurationId>Taoist_InitialActionsTimes</ConfigurationId>
        <Group>Game</Group>
        <Value>3</Value>
      </ConfigurationValueMatches>
    </Criteria>
	<Criteria id="Taoist_InitialMovement_4">
      <ConfigurationValueMatches>
        <ConfigurationId>Taoist_InitialMovement</ConfigurationId>
        <Group>Game</Group>
        <Value>4</Value>
      </ConfigurationValueMatches>
    </Criteria>
	<Criteria id="Taoist_InitialMovement_5">
      <ConfigurationValueMatches>
        <ConfigurationId>Taoist_InitialMovement</ConfigurationId>
        <Group>Game</Group>
        <Value>5</Value>
      </ConfigurationValueMatches>
    </Criteria>
	<Criteria id="Taoist_UnitGain" any="1">
      <ConfigurationValueMatches>
        <ConfigurationId>Taoist_OnlyOne</ConfigurationId>
        <Group>Game</Group>
        <Value>0</Value>
      </ConfigurationValueMatches>
	  <ConfigurationValueMatches>
		<Group>Game</Group>
		<ConfigurationId>Taoist_Settings</ConfigurationId>
		<Value>SETTINGS_TAOIST_STANDARD</Value>
	  </ConfigurationValueMatches>
    </Criteria>
	<Criteria id="Taoist_AllowPromotion" any="1">
      <ConfigurationValueMatches>
        <ConfigurationId>Taoist_AllowPromotion</ConfigurationId>
        <Group>Game</Group>
        <Value>1</Value>
      </ConfigurationValueMatches>
	  <ConfigurationValueMatches>
		<Group>Game</Group>
		<ConfigurationId>Taoist_Settings</ConfigurationId>
		<Value>SETTINGS_TAOIST_STANDARD</Value>
	  </ConfigurationValueMatches>
    </Criteria>
	<Criteria id="Taoist_EnterForeign" any="1">
      <ConfigurationValueMatches>
        <ConfigurationId>Taoist_EnterForeign</ConfigurationId>
        <Group>Game</Group>
        <Value>1</Value>
      </ConfigurationValueMatches>
	  <ConfigurationValueMatches>
		<Group>Game</Group>
		<ConfigurationId>Taoist_Settings</ConfigurationId>
		<Value>SETTINGS_TAOIST_STANDARD</Value>
	  </ConfigurationValueMatches>
    </Criteria>
  </ActionCriteria>  
  <FrontEndActions>
    <UpdateDatabase id="config">
      <Properties>
        <LoadOrder>100</LoadOrder>
      </Properties>
      <File>Data/Taoist_Config.sql</File>
    </UpdateDatabase>
    <UpdateText id="text">
	  <File>Text/Taoist_text.xml</File>
    </UpdateText>
  </FrontEndActions>
  <InGameActions>
    <UpdateDatabase id="database">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
	  <Criteria>SecretSocieties</Criteria>
      <File>Data/Taoist_unit.sql</File>
    </UpdateDatabase>
	<UpdateDatabase id="database">
      <Properties>
        <LoadOrder>1001</LoadOrder>
      </Properties>
