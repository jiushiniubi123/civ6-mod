        <LoadOrder>1001</LoadOrder>
      </Properties>
	  <Criteria>Taoist_InitialActions_3</Criteria>
      <File>Data/Initial/Taoist_Initial_3.sql</File>
    </UpdateDatabase>
	<UpdateDatabase id="database">
      <Properties>
        <LoadOrder>1001</LoadOrder>
      </Properties>
	  <Criteria>Taoist_InitialMovement_4</Criteria>
      <File>Data/Initial/Taoist_Movement_4.sql</File>
    </UpdateDatabase>
	<UpdateDatabase id="database">
      <Properties>
        <LoadOrder>1001</LoadOrder>
      </Properties>
	  <Criteria>Taoist_InitialMovement_5</Criteria>
      <File>Data/Initial/Taoist_Movement_5.sql</File>
    </UpdateDatabase>
	<UpdateDatabase id="database">
      <Properties>
        <LoadOrder>1001</LoadOrder>
      </Properties>
	  <Criteria>Taoist_UnitGain</Criteria>
      <File>Data/Initial/Taoist_UnitGain.sql</File>
    </UpdateDatabase>
	<UpdateDatabase id="database">
      <Properties>
        <LoadOrder>1001</LoadOrder>
      </Properties>
	  <Criteria>Taoist_AllowPromotion</Criteria>
      <File>Data/Initial/Taoist_UnitPromotion.sql</File>
    </UpdateDatabase>
	<UpdateDatabase id="database">
      <Properties>
        <LoadOrder>1001</LoadOrder>
      </Properties>
	  <Criteria>Taoist_EnterForeign</Criteria>
      <File>Data/Initial/Taoist_UnitEnter.sql</File>
    </UpdateDatabase>
    <UpdateIcons id="icon">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
	  <Criteria>SecretSocieties</Criteria>
      <File>Data/Taoist_icon.xml</File>
    </UpdateIcons>
    <UpdateText id="text">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
	  <Criteria>SecretSocieties</Criteria>
      <File>Text/Taoist_text.xml</File>
    </UpdateText>
    <UpdateArt id="art">
      <Properties>
        <LoadOrder>1000</LoadOrder>
        <Context>InGame</Context>
      </Properties>
	  <Criteria>SecretSocieties</Criteria>      
	  <File>Taoist unit.dep</File>
    </UpdateArt>
    <AddUserInterfaces id="ui">
      <Properties>
        <LoadOrder>1000</LoadOrder>
        <Context>InGame</Context>
      </Properties>
	  <Criteria>SecretSocieties</Criteria>
      <File>UI/Taoist_UI.xml</File>
    </AddUserInterfaces>
    <AddGameplayScripts id="lua">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
	  <Criteria>SecretSocieties</Criteria>
      <File>Scripts/Taoist_Gameplay.lua</File>
    </AddGameplayScripts>
  </InGameActions>
