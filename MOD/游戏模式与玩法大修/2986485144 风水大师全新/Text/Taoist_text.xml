		</Replace>
		<Replace Tag="LOC_PROMOTION_TAOIST_SHRINK_LAND_NAME">
			<Text>Shrink land to an inch</Text>
		</Replace>
		<Replace Tag="LOC_PROMOTION_TAOIST_SHRINK_LAND_DESCRIPTION">
			<Text>+1 Maximum number of records, +3 [ICON_MOVEMENT] Movement and ignores zone of control.</Text>
		</Replace>
		<Replace Tag="LOC_PROMOTION_TAOIST_CONCEALMENT_NAME">
			<Text>Cover the clouds</Text>
		</Replace>
		<Replace Tag="LOC_PROMOTION_TAOIST_CONCEALMENT_DESCRIPTION">
			<Text>+2 Maximum number of records, gain stealth for oneself and adjacent land units.</Text>
		</Replace>
		<Replace Tag="LOC_PROMOTION_TAOIST_SUMMON_WIND_RAIN_NAME">
			<Text>Summon wind and rain</Text>
		</Replace>
		<Replace Tag="LOC_PROMOTION_TAOIST_SUMMON_WIND_RAIN_DESCRIPTION">
			<Text>+2 Maximum number of records, +5 [ICON_STRENGTH] Combat Strength for adjacent land units.</Text>
		</Replace>
		<Replace Tag="LOC_PROMOTION_TAOIST_TAOISM_MAGIC_NAME">
			<Text>Taoism Magic</Text>
		</Replace>
		<Replace Tag="LOC_PROMOTION_TAOIST_TAOISM_MAGIC_DESCRIPTION">
			<Text>+3 Maximum number of records</Text>
		</Replace>
		<Replace Tag="LOC_ABILITY_TAOIST_GRAVE_ROBBER_NAME">
			<Text>Ghosts stealing</Text>
		</Replace>
		<Replace Tag="LOC_ABILITY_TAOIST_GRAVE_ROBBER_DESCRIPTION">
			<Text>Combat kills provide [ICON_GOLD] Gold equal to 100% of killed unit's base [ICON_STRENGTH] Combat Strength (on Standard Speed). (From adjacent LeyLine Detector)</Text>
		</Replace>
		<Replace Tag="LOC_ABILITY_TAOIST_CONCEALMENT_NAME">
			<Text>Cover the clouds</Text>
		</Replace>
		<Replace Tag="LOC_ABILITY_TAOIST_CONCEALMENT_DESCRIPTION">
			<Text>Gain stealth (From adjacent LeyLine Detector)</Text>
		</Replace>
		<Replace Tag="LOC_ABILITY_TAOIST_SUMMON_WIND_RAIN_NAME">
			<Text>Summon wind and rain</Text>
		</Replace>
		<Replace Tag="LOC_ABILITY_TAOIST_SUMMON_WIND_RAIN_DESCRIPTION">
			<Text>+5 [ICON_STRENGTH] Combat Strength (From adjacent LeyLine Detector)</Text>
		</Replace>
		<Replace Tag="LOC_ABILITY_TAOIST_SUMMON_WIND_RAIN_STR_DESCRIPTION">
			<Text>+{1_num} from LeyLine Detector</Text>
		</Replace>
	</BaseGameText>
	
