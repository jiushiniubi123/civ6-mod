<GameData>
	<BaseGameText>
		<Replace Tag="LOC_TAOIST_SETTINGS_NAME">
			<Text>LeyLine Detector Settings</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_SETTINGS_DESCRIPTION">
			<Text>Adjust LeyLine Detector ability settings.</Text>
		</Replace>
		<Replace Tag="LOC_SETTINGS_TAOIST_STANDARD_NAME">
			<Text>Standard (Recommended)</Text>
		</Replace>
		<Replace Tag="LOC_SETTINGS_TAOIST_STANDARD_DESCRIPTION">
			<Text>Standard LeyLine Detector ability. Gain one LeyLine Detector when Secret Society gain promotion.</Text>
		</Replace>
		<Replace Tag="LOC_SETTINGS_TAOIST_NORMAL_NAME">
			<Text>Normal (PVP Suitable)</Text>
		</Replace>
		<Replace Tag="LOC_SETTINGS_TAOIST_NORMAL_DESCRIPTION">
			<Text>Retains the basic LeyLine Detector ability. Provides only one LeyLine Detector, with no initial charges, no unique promotions, and stricter Ley Line placement rules.</Text>
		</Replace>
		<Replace Tag="LOC_SETTINGS_TAOIST_CUSTOM_NAME">
			<Text>Custom</Text>
		</Replace>
		<Replace Tag="LOC_SETTINGS_TAOIST_CUSTOM_DESCRIPTION">
			<Text>Manually choose to enable or adjust LeyLine Detector abilities.</Text>
		</Replace>
		
		<Replace Tag="LOC_TAOIST_INITIAL_ACTIONS_NAME">
			<Text>LeyLine Detector Initial Actions</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_INITIAL_ACTIONS_DESCRIPTION">
			<Text>Adjust the Initial Actions for LeyLine Detector (does not affect Maximum number of records)</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_INITIAL_MOVEMENT_NAME">
			<Text>LeyLine Detector Initial Movement</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_INITIAL_MOVEMENT_DESCRIPTION">
			<Text>Adjust the Initial Movement for LeyLine Detector</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_PROMOTION_SUPPLEMENT_NAME">
			<Text>Enable LeyLine Detector Charge Replenishment</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_PROMOTION_SUPPLEMENT_DESCRIPTION">
			<Text>When enabled, the LeyLine Detector gains charges upon promotion equal to the increase in its charge cap (e.g., gaining the "Taoism Magic" promotion, which adds +3 to Maximum number of records, will immediately grant the LeyLine Detector 3 charges).</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_RIGID_TERRAIN_NAME">
			<Text>Enable Strict Terrain Finding</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_RIGID_TERRAIN_DESCRIPTION">
			<Text>When enabled, the LeyLine Detector must satisfy terrain and feature conditions to find Ley Lines.</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_RIGID_TERRAIN_TOOLTIP">
			<Text>Terrain does not meet the conditions for Ley Line Finding.</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_NO_DISTRICT_NAME">
			<Text>Prohibit Generation on Districts</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_NO_DISTRICT_DESCRIPTION">
			<Text>When enabled, the LeyLine Detector cannot find Ley Lines on tiles containing a District.</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_NO_DISTRICT_TOOLTIP">
			<Text>Cannot find Ley Lines on Districts.</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_NO_IMPROVEMENT_NAME">
			<Text>Prohibit Generation on Improvements</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_NO_IMPROVEMENT_DESCRIPTION">
			<Text>When enabled, the LeyLine Detector cannot find Ley Lines on tiles containing an Improvement.</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_NO_IMPROVEMENT_TOOLTIP">
			<Text>Cannot find Ley Lines on Improvements.</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_ALLOW_PROMOTION_NAME">
			<Text>Enable LeyLine Detector Unique Promotions</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_ALLOW_PROMOTION_DESCRIPTION">
			<Text>When enabled, the LeyLine Detector can gain unique promotions when Secret Society gain promotion.</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_ENTER_FOREIGN_NAME">
			<Text>Enable LeyLine Detector Ignores Borders</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_ENTER_FOREIGN_DESCRIPTION">
			<Text>When enabled, the LeyLine Detector can enter foreign cities, ignoring border closures.</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_ONLY_ONE_NAME">
			<Text>Enable Single LeyLine Detector</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_ONLY_ONE_DESCRIPTION">
			<Text>When enabled, only one LeyLine Detector is obtained upon unlocking Secret Society (no further ones are gained).</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_SEA_LEYLINE_NAME">
			<Text>Enable Ley Line Finding on Water</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_SEA_LEYLINE_DESCRIPTION">
			<Text>When enabled, the LeyLine Detector can find Ley Lines on water tiles.</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_DISPOSABLE_NAME">
			<Text>Enable Disposable LeyLine Detector</Text>
		</Replace>
		<Replace Tag="LOC_TAOIST_DISPOSABLE_DESCRIPTION">
			<Text>When enabled, the maximum storage capacity for LeyLine Detector is fixed at 1, and it is removed after its charge is consumed.</Text>
		</Replace>
		
