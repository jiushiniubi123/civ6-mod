		</Replace>
		<Replace Tag="LOC_PPROMOTION_CLASS_PEN_TAOIST_NAME">
			<Text>LeyLine Detector</Text>
		</Replace>
		<Replace Tag="LOC_PROMOTION_TAOIST_GRAVE_ROBBER_NAME">
			<Text>Ghosts stealing</Text>
		</Replace>
		<Replace Tag="LOC_PROMOTION_TAOIST_GRAVE_ROBBER_DESCRIPTION">
