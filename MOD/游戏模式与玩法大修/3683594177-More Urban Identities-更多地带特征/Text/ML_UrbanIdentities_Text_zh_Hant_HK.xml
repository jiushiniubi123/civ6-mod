			<Text>+{1_Amount} [ICON_Strength] 战斗力（{LOC_IDENTITY_SUK_ML_RICH_COPPER_VEINS_NAME}）</Text>
		</Replace>

		<!-- 岩石地带-岩石之都 -->
		<Replace Tag="LOC_IDENTITY_SUK_ML_ROCK_CAPITAL_NAME" Language="zh_Hant_HK">
			<Text>岩石之都</Text>
		</Replace>
		<Replace Tag="LOC_IDENTITY_SUK_ML_ROCK_CAPITAL_DESCRIPTION" Language="zh_Hant_HK">
