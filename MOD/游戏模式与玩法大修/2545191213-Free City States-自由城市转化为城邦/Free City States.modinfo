<?xml version="1.0" encoding="utf-8"?>
<Mod id="5d0e507f-42f7-4738-6fd4-4f3ca98f21ba" version="1">
  <Properties>
    <Name>Free City States</Name>
    <Description>There is a Chance that a free City and its Units become City State Units with a Settler.</Description>
    <Teaser>There is a Chance that a free City and its Units become City State Units with a Settler.</Teaser>
	<Authors>Tiramisu, Zegangani</Authors>
	<CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <ActionCriteria>
    <Criteria id="XP_1">
	   <RuleSetInUse>RULESET_EXPANSION_1</RuleSetInUse>
    </Criteria>
	<Criteria id="CUSTOMIZATION_VI_XP1">
	   <RuleSetInUse>RULESET_EXPANSION_1</RuleSetInUse>
	   <ModInUse>bd8eef16-67e9-404c-f62b-8f4c1fda75a2</ModInUse>
    </Criteria>
	<Criteria id="XP_2">
	   <RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
    </Criteria>
	<Criteria id="CUSTOMIZATION_VI_XP2">
	   <RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
	   <ModInUse>bd8eef16-67e9-404c-f62b-8f4c1fda75a2</ModInUse>
    </Criteria>
	<Criteria id="YNAMP_XP2">
	   <RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
	   <ModInUse>36e88483-48fe-4545-b85f-bafc50dde315</ModInUse>
    </Criteria>
	<Criteria id="CUSTOM_VI_YNAMP_XP2">
	   <RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
	   <ModInUse>bd8eef16-67e9-404c-f62b-8f4c1fda75a2</ModInUse>
	   <ModInUse>36e88483-48fe-4545-b85f-bafc50dde315</ModInUse>
    </Criteria>
  </ActionCriteria>
  <FrontEndActions>
    <UpdateDatabase id="ModdedMapSettings">
	   <Properties>
			<LoadOrder>222222</LoadOrder>
	   </Properties>
	   <Items>
			<File>FreeCityStates_MapSizes.sql</File>
	   </Items>      
    </UpdateDatabase>
    <UpdateDatabase id="CDFSP_Settings">
	   <File>FreeCityStates_Config.xml</File>
    </UpdateDatabase>		
    <UpdateText id="CDFSP_SettingsLocalization">
	   <File>FreeCityStates_ConfigText.xml</File>
    </UpdateText>
  </FrontEndActions> 
  <InGameActions>         
	<AddGameplayScripts id="FreeCityStateScript">
	  <File>FreeCityStates.lua</File> 	
	</AddGameplayScripts>
	<UserInterface id="FreeCityStatesUIScripts">
	  <Properties>
		<Context>InGame</Context>
	  </Properties>
	  <Items>
		<File>FreeCityStatesUIScripts.xml</File>
	  </Items>
	</UserInterface>
	<ImportFiles id="FreeCityStates_XP1" criteria="XP_1">
		<Properties>
			<LoadOrder>500</LoadOrder> <!-- Use higher load order than Gathering Storm DLC 1 -->
	   </Properties>
		<Items>
			<File>Override/AssignStartingPlots.lua</File>
		</Items>
    </ImportFiles>
	<ImportFiles id="FreeCityStates_Customization_VI_XP1" criteria="CUSTOMIZATION_VI_XP1">
		<Properties>
			<LoadOrder>550</LoadOrder>
	   </Properties>
		<Items>
			<File>Override/Customization VI/AssignStartingPlots.lua</File>
		</Items>
    </ImportFiles>
	<ImportFiles id="FreeCityStates_XP2" criteria="XP_2">
		<Properties>
			<LoadOrder>600</LoadOrder>
	   </Properties>
		<Items>
			<File>Override/XP2/AssignStartingPlots.lua</File>
		</Items>
    </ImportFiles>
	<ImportFiles id="FreeCityStates_XP2" criteria="CUSTOMIZATION_VI_XP2">
		<Properties>
			<LoadOrder>650</LoadOrder>
	   </Properties>
		<Items>
			<File>Override/Customization VI/XP2/AssignStartingPlots.lua</File>
		</Items>
    </ImportFiles>
	<ImportFiles id="FreeCityStates_XP2" criteria="YNAMP_XP2">
		<Properties>
			<LoadOrder>650</LoadOrder>
	   </Properties>
		<Items>
			<File>Override/XP2/YNAMP/AssignStartingPlots.lua</File>
		</Items>
    </ImportFiles>
	<ImportFiles id="FreeCityStates_XP2" criteria="CUSTOM_VI_YNAMP_XP2">
		<Properties>
			<LoadOrder>1002222</LoadOrder>
	   </Properties>
		<Items>
			<File>Override/Customization VI/XP2/YNAMP/AssignStartingPlots.lua</File>
		</Items>
    </ImportFiles>
  </InGameActions>
  <Files>
	<File>FreeCityStates_Config.xml</File>
	<File>FreeCityStates_ConfigText.xml</File>
	<File>FreeCityStates.lua</File>
	<File>FreeCityStatesUIScripts.lua</File>
	<File>FreeCityStatesUIScripts.xml</File>
	<File>Override/AssignStartingPlots.lua</File>
	<File>Override/Customization VI/XP2/AssignStartingPlots.lua</File>
	<File>Override/Customization VI/XP2/YNAMP/AssignStartingPlots.lua</File>
	<File>Override/Customization VI/AssignStartingPlots.lua</File>
	<File>Override/XP2/YNAMP/AssignStartingPlots.lua</File>
	<File>Override/XP2/AssignStartingPlots.lua</File>
	<File>FreeCityStates_MapSizes.sql</File>
  </Files>
</Mod>