<?xml version="1.0" encoding="utf-8"?>
<Mod id="F4EBC4E6-8A17-786F-313D-1AD7BE711551" version="1">
  <Properties>
    <Name>CQUIL_SUU_Compatible_Patch</Name>
    <Description>Compatible Patch for "Sukritact's Simple UI Adjustments" and "CQUILite"</Description>
    <Created>1747590994</Created>
    <Teaser>Compatible Patch for "Sukritact's Simple UI Adjustments" and "CQUILite",based on
    CQUILite, do my best to preserve the functionality of another mod</Teaser>
    <Authors>ZHY_Memory</Authors>
    <SpecialThanks>Sukritact infixo</SpecialThanks>
    <AffectsSavedGames>0</AffectsSavedGames>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>


  <InGameActions>
    <AddUserInterfaces id="AddUserInterfaces_Common">
      <Properties>
        <Context>InGame</Context>
        <LoadOrder>20</LoadOrder>
      </Properties>
      <File>PlotInfo_Citizens.xml</File>
      <File>Suk_CityPanelOverview_Instances.xml</File>
    </AddUserInterfaces>
    <ReplaceUIScript id="Replace_CQUI_CityBannerManager">
      <Properties>
        <LuaContext>CityBannerManager</LuaContext>
        <LuaReplace>CityBannerManager_Suk_UI.lua</LuaReplace>
        <LoadOrder>210</LoadOrder>
      </Properties>
    </ReplaceUIScript>
    <ImportFiles id="ImportFiles_CQUI_Conflict">
      <Properties>
        <LoadOrder>20</LoadOrder>
      </Properties>
      <File>CityPanel.lua</File>
      <File>CityPanel.xml</File>
    </ImportFiles>
    <ReplaceUIScript id="Replace_CityPanelOverview">
      <Properties>
        <LoadOrder>20</LoadOrder>
        <LuaReplace>Suk_CityPanelOverview.lua</LuaReplace>
        <LuaContext>CityPanelOverview</LuaContext>
      </Properties>
    </ReplaceUIScript>
  </InGameActions>
  <Files>
    <File>PlotInfo_Citizens.lua</File>
    <File>PlotInfo_Citizens.xml</File>
    <File>CityBannerManager_Suk_UI.lua</File>
    <File>CityPanel.lua</File>
    <File>CityPanel.xml</File>
    <File>Suk_CityPanelOverview.lua</File>
    <File>Suk_CityPanelOverview_Instances.lua</File>
    <File>Suk_CityPanelOverview_Instances.xml</File>
  </Files>
</Mod>