  <LocalizedText>
	<Text id="LOC_MY_MOD_NAME_CITY_STATES_BONUS_VIEWER">
        <en_US>City-States Bonus Viewer (UI)</en_US>
        <zh_Hans_CN>城邦增益列表（UI）</zh_Hans_CN>
		<zh_Hant_HK>城邦增益列表（UI）</zh_Hant_HK>
    </Text> 
    <Text id="LOC_MY_MOD_DESCRIPTION_CITY_STATES_BONUS_VIEWER">
        <en_US>Easily view and compare the unique buffs of the city-states.</en_US>
        <zh_Hans_CN>轻松查看和比较城邦的独特增益。</zh_Hans_CN>
		<zh_Hant_HK>轻松查看和比较城邦的独特增益。</zh_Hant_HK>
    </Text> 
    <Text id="LOC_MY_MOD_TEASER_CITY_STATES_BONUS_VIEWER">
        <en_US>[COLOR_FLOAT_SCIENCE]City-States[ENDCOLOR]</en_US>
        <zh_Hans_CN>[COLOR_FLOAT_SCIENCE]城邦[ENDCOLOR]</zh_Hans_CN>
		<zh_Hant_HK>[COLOR_FLOAT_SCIENCE]城邦[ENDCOLOR]</zh_Hant_HK>
    </Text> 
	<Text id="LOC_MY_MOD_AUTHORS_CITY_STATES_BONUS_VIEWER">
		<en_US>Maple_Leaves</en_US>
		<zh_Hans_CN>枫叶(Maple_Leaves)</zh_Hans_CN>
		<zh_Hant_HK>枫叶(Maple_Leaves)</zh_Hant_HK>
    </Text>
	<Text id="LOC_MY_MOD_SPECIALTHANKS_CITY_STATES_BONUS_VIEWER">
		<en_US>Firaxis</en_US>
		<zh_Hans_CN>Firaxis</zh_Hans_CN>
		<zh_Hant_HK>Firaxis</zh_Hant_HK>
    </Text>
  </LocalizedText>
  
