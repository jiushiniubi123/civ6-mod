		</Replace>
		<Replace Tag="LOC_UNIT_HERO_OYA_NAME" Language="zh_Hant_HK">
			<Text>歐雅</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_OYA_DESCRIPTION" Language="zh_Hant_HK">
