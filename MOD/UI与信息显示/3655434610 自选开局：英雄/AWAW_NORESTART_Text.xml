		</Replace>
		<Replace Tag="LOC_UNIT_HERO_SINBAD_NAME" Language="zh_Hant_HK">
			<Text>辛巴達</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_SINBAD_DESCRIPTION" Language="zh_Hant_HK">
