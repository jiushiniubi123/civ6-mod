<GameData>
	<LocalizedText>
		<Replace Tag="LOC_START_HEROES_NAME" Language="en_US">
			<Text>Custom Start: Heroes</Text>
		</Replace>
		<Replace Tag="LOC_START_HEROES_DESCRIPTION" Language="en_US">
			<Text>Select heroes to be discovered at the start of the game.</Text>
		</Replace>

		<Replace Tag="LOC_START_HEROES_NAME" Language="zh_Hans_CN">
			<Text>自选开局：英雄</Text>
		</Replace>
		<Replace Tag="LOC_START_HEROES_DESCRIPTION" Language="zh_Hans_CN">
			<Text>选择开局即可发现的英雄。</Text>
		</Replace>

		<Replace Tag="LOC_START_HEROES_NAME" Language="zh_Hant_HK">
			<Text>自選開局：英雄</Text>
		</Replace>
		<Replace Tag="LOC_START_HEROES_DESCRIPTION" Language="zh_Hant_HK">
			<Text>選擇開局即可發現的英雄。</Text>
		</Replace>

		<Replace Tag="LOC_START_HEROES_NAME" Language="ja_JP">
			<Text>カスタムスタート：英雄</Text>
		</Replace>
		<Replace Tag="LOC_START_HEROES_DESCRIPTION" Language="ja_JP">
			<Text>ゲーム開始時に発見される英雄を選択します。</Text>
		</Replace>

		<!-- ========================================================== -->
		<!-- ENGLISH (en_US)                                            -->
		<!-- ========================================================== -->
		<Replace Tag="LOC_UNIT_HERO_ANANSI_NAME" Language="en_US">
			<Text>Anansi</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_ANANSI_DESCRIPTION" Language="en_US">
			<Text>Demigod and traveler of African folklore, renowned for his wit and trickery.</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_ARTHUR_NAME" Language="en_US">
			<Text>Arthur</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_ARTHUR_DESCRIPTION" Language="en_US">
			<Text>King and founder of the Knights of the Round Table, renowned for his virtue and chivalry.</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_BEOWULF_NAME" Language="en_US">
			<Text>Beowulf</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_BEOWULF_DESCRIPTION" Language="en_US">
			<Text>Mighty warrior of the far North, renowned for his strength and bravery in single combat.</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_HERCULES_NAME" Language="en_US">
			<Text>Hercules</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_HERCULES_DESCRIPTION" Language="en_US">
			<Text>Demigod of superhuman strength, renowned for his famous Labors.</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_HIMIKO_NAME" Language="en_US">
			<Text>Himiko</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_HIMIKO_DESCRIPTION" Language="en_US">
			<Text>Shaman-Queen of ancient Japan, renowned for her wisdom and mystical power.</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_HIPPOLYTA_NAME" Language="en_US">
			<Text>Hippolyta</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_HIPPOLYTA_DESCRIPTION" Language="en_US">
			<Text>Warrior Queen of the Amazons, renowned for her leadership and martial skill.</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_HUNAHPU_NAME" Language="en_US">
			<Text>Hunahpu &amp; Xbalanque</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_HUNAHPU_DESCRIPTION" Language="en_US">
			<Text>Legendary athletes and heroes of the Maya, renowned for their power over death and the Underworld.</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_MAUI_NAME" Language="en_US">
			<Text>Maui</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_MAUI_DESCRIPTION" Language="en_US">
			<Text>Demigod and hero of Polynesian myth, renowned for his feats and gifts to humanity.</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_MULAN_NAME" Language="en_US">
			<Text>Mulan</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_MULAN_DESCRIPTION" Language="en_US">
			<Text>Devoted and skilled warrior, renowned for her devotion and loyalty.</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_OYA_NAME" Language="en_US">
			<Text>Oya</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_OYA_DESCRIPTION" Language="en_US">
			<Text>Orisha of winds, storms, and lightning, renowned for her extreme power.</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_SINBAD_NAME" Language="en_US">
			<Text>Sinbad</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_SINBAD_DESCRIPTION" Language="en_US">
			<Text>[COLOR_LIGHTBLUE]Naval Hero.[ENDCOLOR] Adventurer and fortune-hunter, renowned for his strange and marvelous travels.</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_WUKONG_NAME" Language="en_US">
			<Text>Sun Wukong</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_WUKONG_DESCRIPTION" Language="en_US">
			<Text>The Monkey King, hero of ancient China, renowned for his cunning and immortality.</Text>
		</Replace>

