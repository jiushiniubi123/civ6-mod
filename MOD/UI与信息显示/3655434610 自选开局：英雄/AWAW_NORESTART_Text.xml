		<Replace Tag="LOC_UNIT_HERO_MULAN_NAME" Language="zh_Hans_CN">
			<Text>花木兰</Text>
		</Replace>
		<Replace Tag="LOC_UNIT_HERO_MULAN_DESCRIPTION" Language="zh_Hans_CN">
			<Text>替父从军的女战士，英勇奉献、忠贞不二。</Text>
		</Replace>
