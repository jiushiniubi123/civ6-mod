<?xml version="1.0" encoding="utf-8"?>
<Mod id="13b2acab-623a-416f-a441-f896244661aa" version="1">
  <Properties>
    <Name>LOC_AWPO_TITLE</Name>
    <Description>LOC_AWPO_DESC</Description>
    <Teaser>LOC_AWPO_DESC</Teaser>
    <Authors>BlueMoon, Windfly</Authors>
    <AffectsSavedGames>0</AffectsSavedGames>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <InGameActions>
    <AddUserInterfaces id="Lua">
      <Properties>
        <Context>InGame</Context>
      </Properties>
      <File>UI/ToolTips.xml</File>
    </AddUserInterfaces>
    <UpdateText id="Text">
      <Properties>
        <LoadOrder>200</LoadOrder>
      </Properties>
      <File>Data_Local.xml</File>
    </UpdateText>
    <ImportFiles id="Import">
      <Properties>
        <LoadOrder>200</LoadOrder>
      </Properties>
      <File>UI/ToolTipHelper.lua</File>
      <File>UI/ToolTips.xml</File>
    </ImportFiles>
  </InGameActions>
  <LocalizedText>
	<Text id="LOC_AWPO_TITLE">
		<en_US>AI Wonder Progress (BM)</en_US>
		<zh_Hans_CN>显示AI奇观进度</zh_Hans_CN>
	</Text>
	<Text id="LOC_AWPO_DESC">
		<en_US>This Mod Adds the Wonder Progress Overview in Tooltip. Updated by BlueMoon (June 2020).</en_US>
		<zh_Hans_CN>这个MOD让玩家可以在奇观提示框里看见其他人的建造进度。</zh_Hans_CN>
	</Text>
  </LocalizedText>
  <Files>
    <File>Data_Local.xml</File>
    <File>UI/ToolTipHelper.lua</File>
    <File>UI/ToolTips.xml</File>
  </Files>
</Mod>