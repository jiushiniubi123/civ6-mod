  <LocalizedText>
	<Text id="LOC_MY_MOD_NAME_WORLD_TRACKER_EXPANDED">
        <en_US>[COLOR_LIGHTBLUE]Maple_Leaves's World Tracker Expanded (UI)[ENDCOLOR]</en_US>
        <zh_Hans_CN>[COLOR_LIGHTBLUE]枫叶的世界追踪扩展（UI）[ENDCOLOR]</zh_Hans_CN>
		<zh_Hant_HK>[COLOR_LIGHTBLUE]枫叶的世界追踪扩展（UI）[ENDCOLOR]</zh_Hant_HK>
    </Text> 
    <Text id="LOC_MY_MOD_DESCRIPTION_WORLD_TRACKER_EXPANDED">
        <en_US>
            Adds three World Tracker Lists, including Natural Wonders, Goody Huts and Barbarian Camps.
        </en_US>
        <zh_Hans_CN>
            新增了“自然奇观”、“部落村庄”和“蛮族哨站”的世界追踪列表。[NEWLINE][NEWLINE]不影响存档。可用于多人模式。
		</zh_Hans_CN>
		<zh_Hant_HK>
			新增了“自然奇观”、“部落村庄”和“蛮族哨站”的世界追踪列表。[NEWLINE][NEWLINE]不影响存档。可用于多人模式。
		</zh_Hant_HK>
    </Text> 
    <Text id="LOC_MY_MOD_TEASER_WORLD_TRACKER_EXPANDED">
        <en_US>[COLOR_LIGHTBLUE]World Tracker Expanded (UI)[ENDCOLOR]</en_US>
        <zh_Hans_CN>[COLOR_LIGHTBLUE]世界追踪扩展（UI）[ENDCOLOR]</zh_Hans_CN>
		<zh_Hant_HK>[COLOR_LIGHTBLUE]世界追踪扩展（UI）[ENDCOLOR]</zh_Hant_HK>
    </Text> 
	<Text id="LOC_MY_MOD_AUTHORS_WORLD_TRACKER_EXPANDED">
		<en_US>Maple_Leaves</en_US>
		<zh_Hans_CN>枫叶(Maple_Leaves)</zh_Hans_CN>
		<zh_Hant_HK>枫叶(Maple_Leaves)</zh_Hant_HK>
    </Text>
	<Text id="LOC_MY_MOD_SPECIALTHANKS_WORLD_TRACKER_EXPANDED">
