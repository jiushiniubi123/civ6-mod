<?xml version="1.0" encoding="utf-8"?>
<Mod id="c195fe46-9357-4b0f-a6f9-65da242ed6fe" version="1">
  <Properties>
    <Name>LOC_MY_MOD_NAME_BETTER_COMBAT_INFO</Name>
    <Description>LOC_MY_MOD_DESCRIPTION_BETTER_COMBAT_INFO</Description>
    <Created>1716563971</Created>
    <Teaser>LOC_MY_MOD_TEASER_BETTER_COMBAT_INFO</Teaser>
    <Authors>LOC_MY_MOD_AUTHORS_BETTER_COMBAT_INFO</Authors>
    <SpecialThanks>LOC_MY_MOD_SPECIALTHANKS_BETTER_COMBAT_INFO</SpecialThanks>
	<AffectsSavedGames>0</AffectsSavedGames>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  
  <LocalizedText>
		<Text id="LOC_MY_MOD_NAME_BETTER_COMBAT_INFO">
			<en_US>Better Combat Preview (UI)</en_US>
			<zh_Hans_CN>更好的战斗信息预览（UI）</zh_Hans_CN>
			<zh_Hant_HK>更好的战斗信息预览（UI）</zh_Hant_HK>
		</Text>
		<Text id="LOC_MY_MOD_DESCRIPTION_BETTER_COMBAT_INFO">
			<en_US>Adds more combat preview information for battles between units. [NEWLINE][NEWLINE]Does not support air combats. [NEWLINE][NEWLINE]Not compatible with "Better Unit List" and "Black Death" mod series.</en_US>
			<zh_Hans_CN>为单位间的战斗新增了更多战斗预览信息。[NEWLINE][NEWLINE]不支持空军单位的战斗。[NEWLINE][NEWLINE]不兼容Better Unit List和Black Death系列mod。</zh_Hans_CN>
			<zh_Hant_HK>为单位间的战斗新增了更多战斗预览信息。[NEWLINE][NEWLINE]不支持空军单位的战斗。[NEWLINE][NEWLINE]不兼容Better Unit List和Black Death系列mod。</zh_Hant_HK>
		</Text>
		<Text id="LOC_MY_MOD_TEASER_BETTER_COMBAT_INFO">
			<en_US>More info in combat preview!</en_US>
			<zh_Hans_CN>更多战斗预览信息！</zh_Hans_CN>
			<zh_Hant_HK>更多战斗预览信息！</zh_Hant_HK>
		</Text>
		<Text id="LOC_MY_MOD_AUTHORS_BETTER_COMBAT_INFO">
			<en_US>Maple_Leaves</en_US>
			<zh_Hans_CN>枫叶(Maple_Leaves)</zh_Hans_CN>
			<zh_Hant_HK>枫叶(Maple_Leaves)</zh_Hant_HK>
		</Text>
		<Text id="LOC_MY_MOD_SPECIALTHANKS_BETTER_COMBAT_INFO">
			<en_US>Firaxis</en_US>
			<zh_Hans_CN>Firaxis</zh_Hans_CN>
			<zh_Hant_HK>Firaxis</zh_Hant_HK>
		</Text>
   </LocalizedText>
	
  <ActionCriteria>
	<Criteria id="BETTER_COMBAT_INFO_Criteria">
		<RuleSetInUse>RULESET_STANDARD,RULESET_EXPANSION_1,RULESET_EXPANSION_2</RuleSetInUse>
	</Criteria>
  </ActionCriteria>
  
  <InGameActions>
    <ImportFiles id="bci_if" criteria="BETTER_COMBAT_INFO_Criteria">
      <Properties>
        <LoadOrder>300000</LoadOrder>
      </Properties>
      <File>UI/Replacements/UnitPanel.xml</File>
      <File>UI/Replacements/UnitPanel.lua</File>
    </ImportFiles>
    <UpdateText id="bci_text" criteria="BETTER_COMBAT_INFO_Criteria">
      <File>Text/BetterCombatInfo_Text_en_US.xml</File>
      <File>Text/BetterCombatInfo_Text_zh_Hans_CN.xml</File>
      <File>Text/BetterCombatInfo_Text_zh_Hant_HK.xml</File>
    </UpdateText>
    <UpdateArt id="bci_art" criteria="BETTER_COMBAT_INFO_Criteria">
      <File>Better_Combat_Informations.dep</File>
    </UpdateArt>
  </InGameActions>
  <Files>
    <File>ArtDefs/Units.artdef</File>
