    </UpdateDatabase>
	<UpdateIcons id="Belief_Rework_Icon" criteria="Expansion2_NO_Huan_MOD">
      <Properties><LoadOrder>10000</LoadOrder></Properties>
      <File>ICON_GREAT_PERSON.sql</File>
    </UpdateIcons>
	<UpdateText id="Belief_Rework_Text_Pantheon" criteria="Expansion2_NO_Huan_MOD">
