      <File>FOLLOWER.sql</File>
    </UpdateDatabase>
    <UpdateDatabase id="Belief_Rework_Database_Worship" criteria="Expansion2_NO_Huan_MOD">
      <Properties><LoadOrder>10000</LoadOrder></Properties>
