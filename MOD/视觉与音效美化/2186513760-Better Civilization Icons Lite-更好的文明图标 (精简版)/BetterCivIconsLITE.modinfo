<?xml version="1.0" encoding="utf-8"?>
<Mod id="f00f068e-c47b-4fcb-974d-7e86ae0cae46" version="1">
  <Properties>
    <Name>Better Civilization Icons Lite</Name>
    <Description>Replaces a number of civilization and city-state icons with more historically accurate or more aesthetically pleasing variations. Preserves a mostly vanilla feel, while hopefully providing improvements.</Description>
    <Created>1616952435</Created>
    <Teaser>Replaces numerous civilization and city-state icons with new and improved variants.</Teaser>
    <Authors>Janboruta</Authors>
    <SpecialThanks>JFD, Sukritact, Tomatekh, Leugi, Lime, P0kiehl</SpecialThanks>
    <AffectsSavedGames>0</AffectsSavedGames>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <FrontEndActions>
    <ImportFiles id="BCILITE_Import">
      <File>Textures/BCILITEAlphaAtlas200.tex</File>
      <File>Textures/BCILITEAlphaAtlas128.tex</File>
      <File>Textures/BCILITEAlphaAtlas80.tex</File>
      <File>Textures/BCILITEAlphaAtlas64.tex</File>
      <File>Textures/BCILITEAlphaAtlas50.tex</File>
      <File>Textures/BCILITEAlphaAtlas48.tex</File>
      <File>Textures/BCILITEAlphaAtlas45.tex</File>
