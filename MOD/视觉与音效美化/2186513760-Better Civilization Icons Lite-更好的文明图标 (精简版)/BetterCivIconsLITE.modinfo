      <File>Textures/BCILITEAlphaAtlas32.tex</File>
      <File>Textures/BCILITEAlphaAtlas30.tex</File>
      <File>Textures/BCILITEAlphaAtlas22.tex</File>
      <File>Textures/BCILITEAlphaAtlas256.tex</File>
    </ImportFiles>
    <UpdateIcons id="BCILITE_Data">
      <Properties>
        <LoadOrder>300</LoadOrder>
      </Properties>
      <File>BCILITEData/BCILITE_Data.sql</File>
    </UpdateIcons>
    <UpdateArt id="UpdateArt">
      <Properties>
        <LoadOrder>300</LoadOrder>
      </Properties>
      <File>Better Civ and City-State Icons.dep</File>
    </UpdateArt>
  </FrontEndActions>
