		<!-- 政策描述 -->
		<Row Tag="LOC_POLICY_HOLY_ARMY_DESCRIPTION" Language="zh_Hans_CN">
			<Text>使城市能够使用 [ICON_Faith]购买陆军单位。</Text>
		</Row>
		<Row Tag="LOC_POLICY_HOLY_NAVY_DESCRIPTION" Language="zh_Hans_CN">
			<Text>使城市能够使用 [ICON_Faith]购买海军单位。</Text>
		</Row>
		<Row Tag="LOC_POLICY_HOLY_AIRFORCE_DESCRIPTION" Language="zh_Hans_CN">
			<Text>使城市能够使用 [ICON_Faith]购买空军单位。</Text>
		</Row>
		<Row Tag="LOC_POLICY_HOLY_SERVICE_DESCRIPTION" Language="zh_Hans_CN">
			<Text>使城市能够使用 [ICON_Faith]购买平民和支援单位。</Text>
		</Row>
		<Row Tag="LOC_POLICY_KIKI_PASSPORTS_DESCRIPTION" Language="zh_Hans_CN">
			<Text>开放所有城邦的边境。</Text>
		</Row>
		<Row Tag="LOC_POLICY_KIKI_SAFE_PASSAGE_DESCRIPTION" Language="zh_Hans_CN">
			<Text>与所有主要文明和平相处时，陆地 [ICON_TradeRoute] 商人无法被掠夺。国际 [ICON_TradeRoute] 贸易路线提供的 [ICON_GOLD] 金币-1。</Text>
		</Row>
		<Row Tag="LOC_POLICY_HOLY_SETTLE_DESCRIPTION" Language="zh_Hans_CN">
			<Text>使城市能够使用 [ICON_Faith] 购买开拓者、建造者和商人。</Text>
		</Row>
		<Row Tag="LOC_POLICY_HOLY_BUILD_DESCRIPTION" Language="zh_Hans_CN">
			<Text>使城市能够使用 [ICON_Faith] 购买建造者。</Text>
		</Row>

		<!-- 百科全书文本 -->
		<Row Tag="LOC_PEDIA_GOVERNMENTS_PAGE_POLICY_HOLY_ARMY_CHAPTER_HISTORY_PARA_1" Language="zh_Hans_CN">
			<Text>使城市能够使用 [ICON_Faith]购买陆军单位。</Text>
		</Row>
		<Row Tag="LOC_PEDIA_GOVERNMENTS_PAGE_POLICY_HOLY_NAVY_CHAPTER_HISTORY_PARA_1" Language="zh_Hans_CN">
			<Text>使城市能够使用 [ICON_Faith]购买海军单位。</Text>
		</Row>
		<Row Tag="LOC_PEDIA_GOVERNMENTS_PAGE_POLICY_HOLY_AIRFORCE_CHAPTER_HISTORY_PARA_1" Language="zh_Hans_CN">
			<Text>使城市能够使用 [ICON_Faith]购买空军单位。</Text>
		</Row>
		<Row Tag="LOC_PEDIA_GOVERNMENTS_PAGE_POLICY_HOLY_SERVICE_CHAPTER_HISTORY_PARA_1" Language="zh_Hans_CN">
			<Text>使城市能够使用 [ICON_Faith]购买民用和支援单位。</Text>
		</Row>
		<Row Tag="LOC_PEDIA_GOVERNMENTS_PAGE_POLICY_KIKI_PASSPORTS_CHAPTER_HISTORY_PARA_1" Language="zh_Hans_CN">
			<Text>开放所有城邦的边境。</Text>
		</Row>
		<Row Tag="LOC_PEDIA_GOVERNMENTS_PAGE_POLICY_KIKI_SAFE_PASSAGE_CHAPTER_HISTORY_PARA_1" Language="zh_Hans_CN">
			<Text>与所有主要文明和平相处时，陆地商人单位无法被掠夺。国际贸易路线提供的金币-1。</Text>
		</Row>
		<Row Tag="LOC_PEDIA_GOVERNMENTS_PAGE_POLICY_HOLY_SETTLE_CHAPTER_HISTORY_PARA_1" Language="zh_Hans_CN">
			<Text>使城市能够使用 [ICON_Faith] 购买开拓者、建造者和商人。</Text>
		</Row>
		<Row Tag="LOC_PEDIA_GOVERNMENTS_PAGE_POLICY_HOLY_BUILD_CHAPTER_HISTORY_PARA_1" Language="zh_Hans_CN">
			<Text>使城市能够使用 [ICON_Faith] 购买建造者。</Text>
		</Row>

