  <Properties>
    <Name>[COLOR:ResGoldLabelCS]Sumus Magnus[ENDCOLOR] - Great People Expansion</Name>
    <Description>Adds new great people with unique and stylish portraits.</Description>
    <Teaser>Adds new Great People with unique and stylish portraits.</Teaser>
    <Authors>Plati</Authors>
    <AffectsSavedGames>1</AffectsSavedGames>
