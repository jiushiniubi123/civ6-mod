<?xml version="1.0" encoding="utf-8"?>
<Mod id="b820e109-c326-7375-b44f-1635a8bedbe5" version="1">
  <Properties>
    <Name>Great Sovereigns</Name>
    <Description>Adds completely new Great People type with new individuals.</Description>
    <Created>1639777325</Created>
    <Teaser>Completely new Great People type.</Teaser>
    <Authors>Plati</Authors>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <ActionCriteria>
	<Criteria id="GreatSovereigns_Reclassify">
		<ConfigurationValueMatches>
			<Group>Game</Group>
			<ConfigurationId>SovereignReclassifyGenerals</ConfigurationId>
			<Value>1</Value>
		</ConfigurationValueMatches>
	</Criteria>
	<Criteria id="Alhambra_Sovereign">
		<ConfigurationValueMatches>
			<Group>Game</Group>
			<ConfigurationId>PlatiAlhambraRework</ConfigurationId>
			<Value>1</Value>
		</ConfigurationValueMatches>
	</Criteria>
	<Criteria id="PLATI_MARITIMES_MODS_ONS">
	  <ModInUse inverse="0">58ecce8a-d3df-430a-b135-280908153662</ModInUse>	<!-- More Maritime: Seaside Sectors -->
	</Criteria>
	<Criteria id="PLATI_WONDER_BURJ_ON">
	  <ModInUse inverse="0">6366039a-6cd8-48d5-99ce-d7832a617629</ModInUse>	<!-- Wonder: Burj Khalifa -->
	</Criteria>
	<Criteria id="PLATI_NATIONAL_WONDERS_ON">
	  <ModInUse inverse="0">8719d97f-0db4-4c18-9863-82eb9b0c6175</ModInUse>	<!-- CIVLIZATION VI: NATIONAL WONDERS -->
	</Criteria>
	<Criteria id="PLATI_MONOPOLY_PLUS_PLUS_ON">
	  <ModInUse inverse="0">b248a322-3e2a-4a6a-830a-6b0d1f3435fc</ModInUse>	<!-- Monopoly ++ -->
	  <ConfigurationValueMatches>
        <ConfigurationId>GAMEMODE_MONOPOLIES</ConfigurationId>
			<Group>Game</Group>
			<Value>1</Value>
      </ConfigurationValueMatches>
	</Criteria>
	<Criteria id="PLATI_MONOPOLY_PLUS_PLUS_OFF">
	  <ModInUse inverse="1">b248a322-3e2a-4a6a-830a-6b0d1f3435fc</ModInUse>	<!-- Monopoly ++ -->
	</Criteria>
	<Criteria id="PLATI_6T_EXPLORER_COLLECTION_ON">
	  <ModInUse inverse="0">25b096b6-3f4f-432a-be25-5680ae03b193</ModInUse>	<!-- Explorers -->
	  <ModInUse inverse="0">3ec8a6fb-2a3f-425f-bff5-b00146b7d5b0</ModInUse>	<!-- Grand Era -->
	  <ModInUse inverse="0">1047a269-38a8-4cee-b70a-a7681015eed7</ModInUse>	<!-- UC Spirituality -->
	</Criteria>
	<Criteria id="PLATI_6T_EXPLORER_COLLECTION_OFF">
	  <ModInUse inverse="1">25b096b6-3f4f-432a-be25-5680ae03b193</ModInUse>	<!-- Explorers -->
	  <ModInUse inverse="1">3ec8a6fb-2a3f-425f-bff5-b00146b7d5b0</ModInUse>	<!-- Grand Era -->
	  <ModInUse inverse="1">1047a269-38a8-4cee-b70a-a7681015eed7</ModInUse>	<!-- UC Spirituality -->
	</Criteria>
	<Criteria id="PLATI_6T_CARAVANS_PILGRIMS_COLLECTION_ON">
	  <ModInUse inverse="0">3ec8a6fb-2a3f-425f-bff5-b00146b7d5b0</ModInUse>	<!-- Grand Era -->
	  <ModInUse inverse="0">27b6c633-3f32-4cc4-9575-e8c586b9fa7a</ModInUse>	<!-- Leugis Caravans and Pilgrims -->
	</Criteria>
	<Criteria id="PLATI_6T_WATER_COLLECTION_ON">
	  <ModInUse inverse="0">3ec8a6fb-2a3f-425f-bff5-b00146b7d5b0</ModInUse>	<!-- Grand Era -->
	  <ModInUse inverse="0">93e0f97a-a9cc-494d-8560-b3b6b9aabdf2</ModInUse>	<!-- UC Entertainment -->
	  <ModInUse inverse="0">58ecce8a-d3df-430a-b135-280908153662</ModInUse>	<!-- More Maritime: Seaside Sectors -->
	</Criteria>
	<Criteria id="PLATI_6T_WATER_COLLECTION_OFF">
	  <ModInUse inverse="1">3ec8a6fb-2a3f-425f-bff5-b00146b7d5b0</ModInUse>	<!-- Grand Era -->
	  <ModInUse inverse="1">93e0f97a-a9cc-494d-8560-b3b6b9aabdf2</ModInUse>	<!-- UC Entertainment -->
	  <ModInUse inverse="1">58ecce8a-d3df-430a-b135-280908153662</ModInUse>	<!-- More Maritime: Seaside Sectors -->
	</Criteria>
	<Criteria id="PLATI_6T_ON">
	  <ModInUse inverse="0">3ec8a6fb-2a3f-425f-bff5-b00146b7d5b0</ModInUse>	<!-- Grand Era -->
	</Criteria>
	<Criteria id="PLATI_6T_OFF">
	  <ModInUse inverse="1">3ec8a6fb-2a3f-425f-bff5-b00146b7d5b0</ModInUse>	<!-- Grand Era -->
	</Criteria>
	<Criteria id="PLATI_6T_ENLIGHTEN_ON">
	  <ModInUse inverse="0">3ec8a6fb-2a3f-425f-bff5-b00146b7d5b0</ModInUse>	<!-- Grand Era -->
	  <ModInUse inverse="0">c6c62855-e22a-47b2-9c36-be0a8c09519e</ModInUse>	<!-- Enlightement Governments -->
	</Criteria>
	<Criteria id="PLATI_JNR_WORSHIP_ON">
	  <ModInUse inverse="0">8be477ae-8642-462d-bcad-768fda353127</ModInUse>	<!-- Urban Complexity: Worship -->
	</Criteria>
	<Criteria id="PLATI_CRITERIA_DRAMATIC_AGES_ENABLED">
      <ConfigurationValueMatches>
        <ConfigurationId>GAMEMODE_DRAMATICAGES</ConfigurationId>
        <Group>Game</Group>
        <Value>1</Value>
      </ConfigurationValueMatches>
    </Criteria>
  </ActionCriteria>
  <FrontEndActions>
	<UpdateDatabase id="Plati_Config">
		<File>GreatSovereigns_Config.xml</File>
		<File>Alhambra_Config.xml</File>
	</UpdateDatabase>
	<UpdateText id="Plati_Config_Text">
		<File>GreatSovereigns_Config_Text.xml</File>
		<File>Alhambra_Config_Text.xml</File>
	</UpdateText>
  </FrontEndActions>
  <InGameActions>
    <UpdateDatabase id="game">
      <File>GreatSovereigns_People.xml</File>
      <File>GreatSovereigns_Core.xml</File>
	  <File>GreatSovereigns_Policy.xml</File>
	  <File>GreatSovereigns_Abilities.xml</File>
