<?xml version="1.0" encoding="utf-8"?>
<Mod id="8259b51f-6e7b-403e-a565-da04a0109613" version="1">
    <Properties>
        <Name>LOC_QUICK_RESTART_NAME</Name>
        <Teaser>Restart Game Immediately</Teaser>
        <Description>Add a button to the top-right corner of the game interface to restart the game directly,skipping to the menu to confirm whether to restart,and skipping clicking "Begin Game" to enter a new game directly.</Description>
        <Authors>Troverist</Authors>
        <SpecialThanks>Hemmelfort</SpecialThanks>
        <AffectsSavedGames>0</AffectsSavedGames>
        <CompatibleVersions>1.2,2.0</CompatibleVersions>
    </Properties>

    <LocalizedText>
        <Text id="LOC_QUICK_RESTART_NAME">
        <en_US>Quick Restart</en_US>
        <zh_Hans_CN>一键重新开始游戏</zh_Hans_CN>
        </Text>
    </LocalizedText>

    <FrontEndActions>
        <UpdateDatabase id="QR_settings">
            <File>config/QR_Input_Config.xml</File>
        </UpdateDatabase>
        <UpdateText id="QR_text">
            <File Priority="1">config/en_us/QR_Options_Text.xml</File>
            <File>config/QR_Options_Translation_Text.xml</File>
        </UpdateText>
    </FrontEndActions>

	<InGameActions>
		<AddUserInterfaces id="QR">
            <Properties>
                <LoadOrder>100000</LoadOrder>
                <Context>InGame</Context>
            </Properties>
			<File>QuickRestart.xml</File>
		</AddUserInterfaces>
        <UpdateText id="QR_text">
            <Properties><LoadOrder>100000</LoadOrder></Properties>
            <File>Text.sql</File>
            <File Priority="1">config/en_us/QR_Options_Text.xml</File>
            <File>config/QR_Options_Translation_Text.xml</File>
        </UpdateText>
        <ImportFiles id="QR_file">
            <Properties><LoadOrder>100000</LoadOrder></Properties>
            <File>QuickRestart.lua</File>
        </ImportFiles>
    </InGameActions>

    <Files>
        <File>config/QR_Input_Config.xml</File>
        <File>config/en_us/QR_Options_Text.xml</File>
        <File>config/QR_Options_Translation_Text.xml</File>
        <File>QuickRestart.xml</File>
        <File>QuickRestart.lua</File>
        <File>Text.sql</File>
    </Files>
</Mod>